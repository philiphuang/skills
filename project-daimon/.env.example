# MCP 服务器环境变量配置示例
# 复制此文件为 .env 并填入真实的 API 密钥

# Context7 API - 上下文管理和长期记忆
# 获取地址: https://context7.com
CONTEXT7_API_KEY=your_context7_api_key_here

# Exa API - AI 驱动的网络搜索
# 获取地址: https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# GitHub Token - GitHub 仓库集成
# 获取地址: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Google API - NotebookLM 集成
# 获取地址: https://console.cloud.google.com
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLOUD_PROJECT=your_project_id_here

# Brave Search API - Brave 搜索引擎集成
# 获取地址: https://api.search.brave.com/app/keys
BRAVE_API_KEY=your_brave_api_key_here

# Search MCP API keys（通过环境变量注入，不在仓库保存）
# Tavily Search API
# 获取地址: https://tavily.com
TAVILY_API_KEY=your_tavily_key
# AnySearch API
ANYSEARCH_API_KEY=your_anysearch_key
# DeepWiki API
DEEPWIKI_API_KEY=your_deepwiki_key
# Exa API 见上方 EXA_API_KEY（已配置）
